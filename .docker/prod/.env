COMPOSE_PROJECT_NAME=twitter-not-dead
####################
#    NODE          #
####################

NODE_VERSION=18

# This should be overwritten during the deployment process (typically generated in Gitlab Pipeline)
# Ex: v2.1.0-solomon
MEDUNES_VERSION=v1.2.3-server

# This should be overwritten during the deployment process (typically generated in Gitlab Pipeline)
# Ex: solomon, beta, lego..
PLATFORM_ENVIRONMENT=server

####################
#    NEXTJS        #
####################
NODE_ENV=production
NODE_PORT=80
PORT=${NODE_PORT}

##########################
#    PERSISTED_DATA      #
##########################
PERSISTED_DATA_DIR=./.docker/prod/data

# Only For local testing
# On live/live-like servers there must be no need for inter-project docker-dns resolution.
# more details here: dev.tn-developers.org:5050/software-engineering/devops/-/blob/master/solva/Makefile
DNS_IP=172.19.19.19
